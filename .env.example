# ==============================================================================
# Aether Agent SDK - Environment Configuration Example
# ==============================================================================
# DO NOT COMMIT PRIVATE KEYS OR SENSITIVE CREDENTIALS TO SOURCE CONTROL.
# Copy this file to .env and configure with your environment-specific settings.

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Stellar / Soroban Configuration
# ------------------------------------------------------------------------------
# Network: TESTNET | MAINNET | FUTURENET | LOCAL
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Agent Stellar Public Key / Address (Do NOT put secret keys here)
STELLAR_AGENT_PUBLIC_KEY=GBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Default Stellar Assets
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ------------------------------------------------------------------------------
# EVM Configuration
# ------------------------------------------------------------------------------
# Network: SEPOLIA | MAINNET | BASE | OPTIMISM | ARBITRUM | POLYGON | LOCAL
EVM_NETWORK=SEPOLIA
EVM_CHAIN_ID=11155111
EVM_RPC_URL=https://rpc.sepolia.org

# Agent EVM Address (Do NOT put private keys here)
EVM_AGENT_ADDRESS=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# Agent Execution & Policy Limits
# ------------------------------------------------------------------------------
AGENT_MAX_PAYMENT_AMOUNT=100.00
AGENT_DAILY_LIMIT=1000.00
AGENT_CONFIRMATION_TIMEOUT_MS=30000
AGENT_RETRY_MAX_ATTEMPTS=3
AGENT_RETRY_DELAY_MS=1000
