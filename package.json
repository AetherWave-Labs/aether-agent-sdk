{
  "name": "aether-agent-sdk",
  "version": "0.1.0",
  "description": "Modular SDK for building autonomous agents that interact with blockchain infrastructure, execute on-chain token payments, query decentralized RPCs, and interact with smart contracts across Stellar Soroban and EVM-compatible networks.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/tests/unit/payments/amount.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  "name": "@aetherwave/aether-agent-sdk",
  "version": "0.1.0",
  "description": "Modular SDK for autonomous on-chain payments, decentralized RPC queries, and smart-contract interactions across Stellar/Soroban and EVM-compatible networks.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "keywords": [
    "stellar",
    "soroban",
    "evm",
    "agent",
    "sdk",
    "autonomous",
    "payments",
    "smart-contracts",
    "rpc",
    "usdc",
    "blockchain"
  ],
  "author": "AetherWave Labs",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  }
}
